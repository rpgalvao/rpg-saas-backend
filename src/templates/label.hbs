<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<style>
			body {
				margin: 0;
				padding: 2mm;
				font-family: sans-serif;
				font-size: 8px;
				color: #000;
				width: 46mm; /* Margem de respiro para a etiqueta de 50mm */
				height: 26mm;
				display: flex;
				align-items: center;
				background-color: #fff;
				box-sizing: border-box;
			}
			.qr-container {
				width: 35%;
				display: flex;
				justify-content: center;
				align-items: center;
			}
			.qr-container img {
				width: 100%;
				max-width: 16mm;
			}
			.text-container {
				width: 65%;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding-left: 3mm;
				line-height: 1.35;
			}
			.logo {
				max-height: 6mm;
				object-fit: contain;
				margin-bottom: 2px;
			}
			.text-container strong {
				font-size: 9px;
				margin-bottom: 1px;
			}
			.footer {
				margin-top: 2px;
				font-size: 6px;
				border-top: 1px solid #000;
				padding-top: 2px;
				line-height: 1.1;
			}
		</style>
	</head>
	<body>
		<div class="qr-container">
			<img src="{{qrCodeDataUrl}}" alt="QR Code" />
		</div>
		<div class="text-container">
			{{#if logo_url}}
				<img src="{{logo_url}}" class="logo" alt="DWL" />
			{{else}}
				<strong>DWL O.S.: {{osNumber}}</strong>
			{{/if}}

			<span><strong>O.S.:</strong> {{osNumber}}</span>
			<span><strong>Tipo:</strong> {{osType}}</span>
			<span><strong>Data:</strong> {{currentDate}}</span>
			<span><strong>Próx.:</strong> {{nextDate}}</span>

			<div class="footer">
				dwldiagnostica.com.br
			</div>
		</div>
	</body>
</html>